# Public hostname Caddy serves. Use "localhost" for local runs.
LOOM_DOMAIN=localhost
# Postgres connection string used by the server.
DATABASE_URL=postgres://loom:loom@localhost:5432/loom
# Comma-separated instance keeper tokens, each 32 random bytes base64url (43 chars). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LOOM_KEEPER_TOKENS=
PORT=3000
# Interface the server binds to. Defaults to 127.0.0.1 so a host-run dev server (./run.sh) is only
# reachable through Caddy, not directly on the LAN. The Docker image sets this to 0.0.0.0 itself
# (safe there: compose never publishes port 3000, so it's only reachable on the Docker network) —
# leave this unset unless you know you want to change it.
LOOM_HOST=127.0.0.1
