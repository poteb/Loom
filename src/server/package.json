  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "hono": "4.13.7",
    "@hono/node-server": "2.1.1",
    "ws": "8.21.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@testcontainers/postgresql": "12.1.0"
  }
}
